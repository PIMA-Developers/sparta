{%- comment -%}
  TAP flow runtime (non-module): registers capture listeners early so addon toggles
  still work even if other theme scripts stopPropagation in capture.
{%- endcomment -%}
<script src="{{ 'flow-engine-runtime.js' | asset_url }}" defer></script>

{%- comment -%}
  HOTFIX: Some theme listeners cancel clicks on inputs before our blocks see them.
  Register a tiny capture-phase pointer handler in the HEAD so checkbox taps always toggle.
{%- endcomment -%}
<script>
  (function () {
    if (window.__flowAddonHeadFixInstalled) return;
    window.__flowAddonHeadFixInstalled = true;

    // Mark installation (debuggable via CSS when cart_debug=1).
    try { document.documentElement.setAttribute('data-flow-addon-headfix', '1'); } catch (_) {}

    function closestItem(el) {
      if (!el || !el.closest) return null;
      var item = el.closest('[data-addon-variant-id]');
      if (item) return item;
      // Fallback: some markup variations wrap the dataset on a nested element.
      item = el.closest('.flow-addon__item');
      if (!item) return null;
      if (item.hasAttribute && item.hasAttribute('data-addon-variant-id')) return item;
      var owned = item.querySelector && item.querySelector('[data-addon-variant-id]');
      return owned && owned.hasAttribute && owned.hasAttribute('data-addon-variant-id') ? owned : null;
    }

    function findCheckbox(item) {
      if (!item) return null;
      var cb = item.querySelector('input[type="checkbox"][data-flow-addon-toggle]');
      return cb && cb.tagName === 'INPUT' ? cb : null;
    }

    function setSelected(item, selected) {
      item.dataset.addonSelected = String(!!selected);
      var cb = findCheckbox(item);
      if (cb) cb.checked = !!selected;
    }

    function isDebug() {
      try {
        var url = new URL(window.location.href);
        return url.searchParams.has('cart_debug') || (window.localStorage && window.localStorage.getItem('cart_debug') === '1');
      } catch (_) {
        return false;
      }
    }

    function debugPulse(item) {
      if (!isDebug() || !item) return;
      item.setAttribute('data-headfix-pulse', '1');
      window.setTimeout(function () { item.removeAttribute('data-headfix-pulse'); }, 200);
    }

    function hardStop(e) {
      e.preventDefault();
      e.stopPropagation();
      if (typeof e.stopImmediatePropagation === 'function') e.stopImmediatePropagation();
    }

    function handleToggleEvent(e) {
      var t = e.target;
      if (!t || !t.closest) return;
      if (t.closest('[data-flow-addon-quantity]')) return;

      // Only act for real addon toggles (checkbox) or clicks inside toggle area.
      var inToggleArea = t.closest('[data-flow-addon-toggle-area]') || t.closest('[data-flow-addon-toggle]');
      if (!inToggleArea) return;

      var item = closestItem(t);
      if (!item) return;
      if (!item.closest('[data-flow-addon]')) return;

      hardStop(e);

      var isSelected = item.dataset.addonSelected === 'true';
      var next = !isSelected;
      setSelected(item, next);

      var cb = findCheckbox(item);
      if (cb) cb.dispatchEvent(new Event('change', { bubbles: true }));

      debugPulse(item);
    }

    document.addEventListener(
      'pointerdown',
      handleToggleEvent,
      true
    );

    // Some themes still swallow pointerdown but let click through (or vice-versa).
    // Capture both and make the toggle authoritative.
    document.addEventListener('click', handleToggleEvent, true);
  })();
</script>

<style>
  /* Visual debug: confirms HEAD hotfix fired */
  [data-headfix-pulse="1"] { outline: 2px solid #ff3b30 !important; outline-offset: 2px !important; }
  /* If the HEAD fix is installed, tint toggle area on debug pages. */
  html[data-flow-addon-headfix="1"] body:has([data-flow-addon]) [data-flow-addon-toggle-area] { -webkit-tap-highlight-color: transparent; }
</style>

